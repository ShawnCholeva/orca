{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca",
  "identifier": "dev.orca.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "pnpm --filter @orca/daemon build:sidecar"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orca",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "backgroundColor": "#0B1020"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../../daemon/dist/sidecar/orca-daemon"],
    "resources": {
      "../../daemon/dist/sidecar/runtime": "runtime"
    }
  }
}
