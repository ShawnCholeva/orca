{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/daemon": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": "src/**/*.ts"
    },
    "apps/desktop": {
      "entry": ["src/main.tsx", "src/**/*.test.{ts,tsx}"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    }
  }
}
